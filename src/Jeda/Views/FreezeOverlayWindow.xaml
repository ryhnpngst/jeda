<Window x:Class="Jeda.Views.FreezeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="False"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Background="Black"
        Title="JEDA Freeze Overlay">
    <Grid Background="Black" IsHitTestVisible="False">
        <Image x:Name="OverlayImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Focusable="False"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
