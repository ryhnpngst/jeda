<Window x:Class="Jeda.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jeda.ViewModels"
        Title="JEDA – Pause the Screen, Keep Working"
        Icon="../Assets/app.ico"
        Height="320" Width="680"
        MinHeight="300" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Brand Icon -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="../Assets/jeda-icon.png"
                   Width="40" Height="40"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="JEDA"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock Text="Pause the Screen, Keep Working."
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,1,0,0" />
            </StackPanel>
        </Grid>

        <!-- Status Card (FR-08) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="14" Height="14"
                         VerticalAlignment="Top"
                         Margin="0,4,12,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#10B981" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                    <Setter Property="Fill" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status.Message}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />
                    <TextBlock Text="{Binding Status.Details}"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding MonitorSummary}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#1D4ED8" />
                </Border>
            </Grid>
        </Border>

        <!-- Shortcut Information Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="GLOBAL SHORTCUT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B" />
                    <TextBlock Text="Gunakan kombinasi tombol ini kapan saja untuk Freeze / Resume"
                               FontSize="13"
                               Foreground="#334155"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyHint}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A" />
                </Border>
            </Grid>
        </Border>

        <!-- Footer Notes -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <TextBlock Text="JEDA Desktop Presentation Utility v1.0 • .NET 10 WPF"
                       FontSize="11"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
