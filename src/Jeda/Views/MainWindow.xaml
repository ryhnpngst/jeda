<Window x:Class="Jeda.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Jeda.ViewModels"
        Title="JEDA – Pause the Screen, Keep Working"
        Height="540" Width="680"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="JEDA"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#0F172A" />
            <TextBlock Text="Pause the Screen, Keep Working."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Status Card (FR-08) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="14" Height="14"
                         VerticalAlignment="Top"
                         Margin="0,4,12,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#10B981" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                    <Setter Property="Fill" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Status.Message}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />
                    <TextBlock Text="{Binding Status.Details}"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Monitor Selection Card (FR-01, FR-06) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="PILIH MONITOR TUJUAN"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#475569"
                           Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Monitors}"
                              SelectedItem="{Binding SelectedMonitor}"
                              DisplayMemberPath="DisplayTitle"
                              Height="36"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Padding="8,0" />

                    <Button Grid.Column="1"
                            Command="{Binding RefreshMonitorsCommand}"
                            Content="Segarkan"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Height="36" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Action & Hotkey Area -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GLOBAL SHORTCUT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B" />
                    <TextBlock Text="{Binding HotkeyHint}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,2,0,0" />
                    <TextBlock Text="Tekan shortcut di atas kapan saja untuk Freeze / Resume"
                               FontSize="12"
                               Foreground="#94A3B8" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding ToggleFreezeCommand}"
                        Content="{Binding ActionButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="200"
                        Height="44" />
            </Grid>
        </Border>

        <!-- Footer Notes -->
        <Border Grid.Row="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
            <TextBlock Text="JEDA Desktop Presentation Utility v1.0 • .NET 10 WPF"
                       FontSize="11"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>

